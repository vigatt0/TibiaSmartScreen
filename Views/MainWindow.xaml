<Window x:Class="TibiaSmartScreen.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TibiaSmartScreen"
        Width="320" Height="580"
        MinWidth="280" MinHeight="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <!-- Outer border with drop-shadow -->
    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4"
                              Opacity="0.7" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>   <!-- custom title bar -->
                <RowDefinition Height="*"/>    <!-- content -->
                <RowDefinition Height="28"/>   <!-- status bar -->
            </Grid.RowDefinitions>

            <!-- ── Custom title bar ──────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="14,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Red accent dot -->
                        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="TibiaSmartScreen"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Title bar buttons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="MinBtn"  Content="─" Style="{StaticResource IconButton}"
                                Click="MinBtn_Click"  ToolTip="Minimize"/>
                        <Button x:Name="CloseBtn" Content="✕" Style="{StaticResource IconButton}"
                                Click="CloseBtn_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Main content ──────────────────────────────── -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,12,14,8" >

                    <!-- Section: Controls -->
                    <TextBlock Text="CONTROLS"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <!-- Add Region button -->
                    <Button Content="＋  Add Region"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddRegionCommand}"
                            HorizontalAlignment="Stretch"
                            Height="38"
                            Margin="0,0,0,8"
                            ToolTip="Select a screen region to capture (F9)"/>

                    <!-- Lock / Unlock all -->
                    <Button x:Name="LockAllBtn"
                            Content="{Binding LockButtonText}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleLockCommand}"
                            HorizontalAlignment="Stretch"
                            Height="34"
                            Margin="0,0,0,8"
                            ToolTip="Lock all overlays (enables click-through on all)"/>

                    <!-- Delete selected -->
                    <Button Content="🗑  Delete Selected"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteSelectedCommand}"
                            HorizontalAlignment="Stretch"
                            Height="34"
                            Margin="0,0,0,16"
                            ToolTip="Remove the selected region"/>

                    <!-- Section: Opacity -->
                    <TextBlock Text="GLOBAL OPACITY"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Style="{StaticResource DarkSlider}"
                                Minimum="0.05" Maximum="1.0"
                                Value="{Binding GlobalOpacity, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding GlobalOpacity, StringFormat={}{0:P0}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Section: FPS -->
                    <TextBlock Text="TARGET FPS"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Style="{StaticResource DarkSlider}"
                                Minimum="5" Maximum="60"
                                SmallChange="5" LargeChange="10"
                                Value="{Binding TargetFps, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TargetFps, StringFormat={}{0} fps}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Section: Regions list -->
                    <TextBlock Text="ACTIVE REGIONS"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ListBox x:Name="RegionsListBox"
                                 ItemsSource="{Binding Regions}"
                                 SelectedItem="{Binding SelectedRegion, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource RegionListItem}"
                                 MaxHeight="200"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10">
                                                <Run Text="{Binding CaptureWidth, Mode=OneWay}"/>
                                                <Run Text="×"/>
                                                <Run Text="{Binding CaptureHeight, Mode=OneWay}"/>
                                                <Run Text=" px"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="🔓"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Text" Value="🔒"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Empty state hint -->
                    <TextBlock Text="No regions yet — click 'Add Region' to start"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Regions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Save layout button -->
                    <Button Content="💾  Save Layout"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding SaveLayoutCommand}"
                            HorizontalAlignment="Stretch"
                            Height="32"
                            Margin="0,14,0,4"
                            ToolTip="Save current regions to disk"/>

                    <!-- Hotkey hint -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            CornerRadius="5"
                            Padding="10,7"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="HOTKEYS" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Add region"   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="F9"           FontSize="11" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Lock / Unlock" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="F10"          FontSize="11" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Hide all"     FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="F11"          FontSize="11" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Status bar ────────────────────────────────── -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="0,0,8,8"
                    Padding="12,0">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

        </Grid>
    </Border>
</Window>
