<Window x:Class="TibiaSmartScreen.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        MinWidth="120"
        MinHeight="90">

    <Grid x:Name="RootGrid">
        <!-- Drop shadow effect -->
        <Grid.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3"
                              Opacity="0.6" Direction="270"/>
        </Grid.Effect>

        <!-- ── Main content border ──────────────────────────── -->
        <Border x:Name="ContentBorder"
                Background="#0D0D0D"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title bar (drag handle) -->
                <Border Grid.Row="0"
                        x:Name="TitleBar"
                        Background="#1A1A1A"
                        CornerRadius="5,5,0,0"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid Margin="8,0,4,0">
                        <TextBlock x:Name="TitleText"
                                   Foreground="#888888"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="180"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <!-- FPS counter -->
                            <TextBlock x:Name="FpsLabel"
                                       Foreground="#444444"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <!-- Lock button -->
                            <Button x:Name="LockBtn"
                                    Content="🔓"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Lock (enable click-through)"
                                    Click="LockBtn_Click"/>
                            <!-- Close button -->
                            <Button x:Name="CloseBtn"
                                    Content="✕"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Remove overlay"
                                    Click="CloseBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Captured screen image -->
                <Image Grid.Row="1"
                       x:Name="CaptureImage"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="LowQuality"/>
            </Grid>
        </Border>

        <!-- ── Resize handles (8 directions) ───────────────── -->
        <!-- Corners -->
        <Rectangle Width="12" Height="12" Fill="Transparent" Cursor="SizeNWSE"
                   HorizontalAlignment="Left"  VerticalAlignment="Top"    Tag="NW"
                   MouseLeftButtonDown="Resize_MouseDown"/>
        <Rectangle Width="12" Height="12" Fill="Transparent" Cursor="SizeNESW"
                   HorizontalAlignment="Right" VerticalAlignment="Top"    Tag="NE"
                   MouseLeftButtonDown="Resize_MouseDown"/>
        <Rectangle Width="12" Height="12" Fill="Transparent" Cursor="SizeNESW"
                   HorizontalAlignment="Left"  VerticalAlignment="Bottom" Tag="SW"
                   MouseLeftButtonDown="Resize_MouseDown"/>
        <Rectangle Width="12" Height="12" Fill="Transparent" Cursor="SizeNWSE"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Tag="SE"
                   MouseLeftButtonDown="Resize_MouseDown"/>
        <!-- Edges -->
        <Rectangle Height="8" Fill="Transparent" Cursor="SizeNS"
                   HorizontalAlignment="Stretch" VerticalAlignment="Top"    Margin="12,0" Tag="N"
                   MouseLeftButtonDown="Resize_MouseDown"/>
        <Rectangle Height="8" Fill="Transparent" Cursor="SizeNS"
                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="12,0" Tag="S"
                   MouseLeftButtonDown="Resize_MouseDown"/>
        <Rectangle Width="8"  Fill="Transparent" Cursor="SizeWE"
                   HorizontalAlignment="Left"  VerticalAlignment="Stretch" Margin="0,26" Tag="W"
                   MouseLeftButtonDown="Resize_MouseDown"/>
        <Rectangle Width="8"  Fill="Transparent" Cursor="SizeWE"
                   HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,26" Tag="E"
                   MouseLeftButtonDown="Resize_MouseDown"/>
    </Grid>
</Window>
